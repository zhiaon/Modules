#!name=Surge 运行时长
#!desc=V1.0 面板显示 Surge 引擎本次已运行多久、启动于何时、配置重载过几次。靠 engine-started / profile-reloaded 事件记录时间戳，数值与 Surge 实际运行时长一致；每分钟自动刷新，不需要控制密码与 MitM。需 Surge iOS 5.22 及以上。
#!author=许舟
#!category=网络

[Panel]
Surge 运行时长 = title="Surge 运行时长",content="正在读取启动记录…\n\n点右上角刷新按钮立即更新",style=info,script-name=Surge 运行时长,update-interval=60

[Script]
Surge 运行时长-记录启动 = type=event,event-name=engine-started,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/surge-uptime-panel.js,script-update-interval=86400,argument=record,timeout=10
Surge 运行时长-记录重载 = type=event,event-name=profile-reloaded,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/surge-uptime-panel.js,script-update-interval=86400,argument=record,timeout=10
Surge 运行时长 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/surge-uptime-panel.js,script-update-interval=86400,argument=panel,timeout=15
