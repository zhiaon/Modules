#!name=机场流量
#!desc=V1.3：订阅链接给出 6 个独立格子（url1~url6），每格还能用分号再塞多个；多机场自动切紧凑排版（3 行/机场）并在末尾给合计。在 Surge 策略页显示机场的总流量、已消耗、剩余、进度条、上行/下行、下次重置日与到期日；数据直读订阅响应头 subscription-userinfo，本机请求不经中转。
#!author=zhiaon
#!category=网络
#!icon=gauge.with.needle
#!arguments=name:机场,url1:https://example.com/sub,url2:none,url3:none,url4:none,url5:none,url6:none,resetday:1,ua:Clash/1.18.0,policy:none
#!arguments-desc=【① 机场名 name】面板标题显示的名字。多个机场用英文分号 ; 分隔，顺序与下面 url1~url6 的填写顺序一一对应。例：花云;云梯;奶牛;番墙;闪电;龟速。名字不够会自动补「机场N」，多了会忽略。\n【②~⑦ 订阅链接 url1~url6】每个格子填一个机场的订阅地址，6 格正好 6 个机场，一一对应。必须是完整 https 链接，带 ?token= 和 & 的部分全部照抄。某一格不用就保持 none。想在某一格里再放多个，用英文分号分隔（例：url1 填 https://a/sub?token=x;https://b/sub?token=y）。\n【⑧ 每月重置日 resetday】1 到 31，默认 1。所有机场共用；填 31 遇到小月自动按当月最后一天算。\n【⑨ UA ua】拉订阅用的 User-Agent，默认 Clash/1.18.0。提示「无流量头」时改成 Surge/5.16.0 或机场文档指定的 UA。\n【⑩ 指定策略 policy】拉订阅时强制走的策略名，默认 none 跟随规则。机场域名直连拉不到流量时填节点组名，例：节点选择。\n【排坑】① 十个参数由模块自动用英文竖线 | 拼接，你不用管。② 参数值里绝对不能出现英文逗号，Surge 会在逗号处截断整行。③ 同一格放多个链接用分号，别用逗号。④ 每格只放一个是最省心的用法。

[Panel]
机场流量 = title="{{{name}}}",content="数据加载中…\n\n点这张卡右上角的刷新按钮立即拉取，或等下次自动更新（10 分钟）",style=info,script-name=机场流量,update-interval=600

[Script]
机场流量 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/airport-panel.js,argument="{{{name}}}|{{{url1}}}|{{{resetday}}}|{{{ua}}}|{{{policy}}}|{{{url2}}}|{{{url3}}}|{{{url4}}}|{{{url5}}}|{{{url6}}}",timeout=60
