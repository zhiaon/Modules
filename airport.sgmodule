#!name=机场流量
#!desc=V3.0：六个机场各占一组三格（机场名 / 订阅链接 / 每月重置日），一一配对，想用几个填几个。在 Surge 策略页显示每个机场的总流量、已消耗、剩余、进度条、上行/下行、下次重置日与到期日；多机场自动紧凑排版（3 行/机场）并给合计。数据直读订阅响应头 subscription-userinfo，本机请求不经过任何第三方中转。
#!author=zhiaon
#!category=网络
#!icon=gauge.with.needle
#!arguments=name1:机场1,url1:https://example.com/sub,day1:1,name2:none,url2:none,day2:1,name3:none,url3:none,day3:1,name4:none,url4:none,day4:1,name5:none,url5:none,day5:1,name6:none,url6:none,day6:1
#!arguments-desc=每个机场一组三格：名字 / 订阅链接 / 每月重置日，按顺序一一配对。不用哪个机场，把那一组三格留空（或保持 none）即可。\n【① name1 机场1 名字】面板里显示的名字，例：花云\n【② url1 机场1 订阅链接】完整 https 链接，带 ?token= 和 & 的部分全部照抄\n【③ day1 机场1 重置日】这家每月几号清零，1-31；填 31 遇到小月自动按当月最后一天算\n【④⑤⑥ 机场2：名字 / 链接 / 重置日】\n【⑦⑧⑨ 机场3：名字 / 链接 / 重置日】\n【⑩⑪⑫ 机场4：名字 / 链接 / 重置日】\n【⑬⑭⑮ 机场5：名字 / 链接 / 重置日】\n【⑯⑰⑱ 机场6：名字 / 链接 / 重置日】\n【说明】① 重置日留空时自动沿用第一个填了重置日的机场，全空就是 1 号。② 十八个参数由模块自动用英文竖线 | 拼给脚本，你不用管。③ 参数值里绝对不能出现英文逗号，Surge 会在逗号处截断整行。④ UA 固定 Clash/1.18.0，没有额外开关；某家不返回流量头时告诉我，我给它单独开分支。

[Panel]
机场流量 = title="机场流量",content="数据加载中…\n\n点这张卡右上角的刷新按钮立即拉取，或等下次自动更新（10 分钟）",style=info,script-name=机场流量,update-interval=600

[Script]
机场流量 = type=generic,script-path=https://cdn.jsdelivr.net/gh/zhiaon/Modules@main/surge_scripts/airport-panel.js,argument="{{{name1}}}|{{{url1}}}|{{{day1}}}|{{{name2}}}|{{{url2}}}|{{{day2}}}|{{{name3}}}|{{{url3}}}|{{{day3}}}|{{{name4}}}|{{{url4}}}|{{{day4}}}|{{{name5}}}|{{{url5}}}|{{{day5}}}|{{{name6}}}|{{{url6}}}|{{{day6}}}",timeout=60
