#!name=DNS 清理缓存
#!desc=一键刷新 Surge DNS 缓存：卡片显示缓存条目数与上次刷新时间，点击后执行刷新并回读条目数核对，成功、未生效或失败都如实显示。
#!author=许舟
#!version=v1.0.1
#!category=网络
#!icon=arrow.triangle.2.circlepath

[Panel]
DNSCacheRefresh = title="DNS 清理缓存",content="缓存条目: -\n本地映射: -\n上次刷新: -\n点右上角 ⟳ 执行刷新",style=info,script-name=DNSCacheRefresh,update-interval=30

[Script]
DNSCacheRefresh = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/dns-refresh.js,script-update-interval=86400,timeout=20
