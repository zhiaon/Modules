#!name=淘宝去广告
#!desc=淘宝开屏净化：仅处理开屏接口中明确标记的广告容器，关闭开屏控制字段并清空广告素材地址；商品、搜索、购物车、订单与支付数据原样保留。需开启脚本与 MITM 并信任 Surge CA。
#!version=v1.0.1
#!author=Minis
#!category=去广告

# 仅匹配明确开屏 API；不清空首页配置，不拦通用商品视频和共享活动模板。
# 不添加整域 REJECT、不修改证书、不访问 Cookie、不自动删除 App 缓存。
[Script]
TB开屏净化 = type=http-response,pattern=^https://guide-acs\.m\.taobao\.com/gw/mtop\.taobao\.wireless\.home\.splash\.awesome\.get(?:/|\?|$),requires-body=true,max-size=2097152,full-header-mode=true,timeout=10,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/taobao-clean.js,script-update-interval=86400

[MITM]
hostname = %APPEND% guide-acs.m.taobao.com
