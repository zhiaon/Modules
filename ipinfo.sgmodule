#!name=网络IP信息
#!desc=V1.2 显示当前网络的 IP 全链路：本机公网 IP、各策略组的真实入口 IP 与节点落地 IP，均含位置和运营商。兜底组常驻，不受参数影响。首行显示 Wi-Fi 名，蜂窝下显示「蜂窝流量」。
#!author=许舟
#!version=1.2
#!category=网络
#!icon=network
#!arguments=目标:填写策略组名
#!arguments-desc=【目标】\n是什么：要查看链路信息的策略组或节点。\n怎么填：填策略组名或节点名，多个用竖线分隔。\n· 留空则只显示兜底组\n· Proxy\n· Proxy|日本|小红书\n注意：无论这里填什么，FINAL 那条兜底策略组都会额外单独显示一份。\n\n————\n\n面板显示本机公网 IP、各策略组的真实入口 IP 与节点落地 IP，均含位置和运营商。\n首行显示当前 Wi-Fi 名称，蜂窝网络下显示「蜂窝流量」。

[Panel]
网络IP信息 = title="网络IP信息",content="SSID: -\n\n本地 IP: -\n位置: -\n运营商: -\n\n────────────────\n◆策略: -\n入口: -\n位置: -\n运营商: -\n\n落地 IP: -\n位置: -\n运营商: -\n\n执行时间: -",style=info,script-name=网络IP信息,update-interval=600

[Script]
网络IP信息 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/ipinfo-panel.js,script-update-interval=86400,argument="{{{目标}}}",timeout=45
