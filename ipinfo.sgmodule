#!name=网络IP信息
#!desc=网络 IP 信息面板：显示本机公网 IP，以及各策略组的真实入口 IP 与节点落地 IP、位置与运营商；兜底组常驻不受参数影响，首行显示 Wi-Fi 名。
#!author=许舟
#!version=v1.2.1
#!category=网络
#!icon=network
#!arguments=目标:填写策略组名
#!arguments-desc=【目标】\n功能说明：要查看链路信息的策略组或节点。\n配置方法：填策略组名或节点名，多个用竖线分隔。\n取值示例：\n· 留空则只显示兜底组\n· Proxy\n· Proxy|日本|小红书\n注意事项：无论这里填什么，FINAL 那条兜底策略组都会额外单独显示一份。\n\n————\n\n整体备注：\n· 面板显示本机公网 IP、各策略组的真实入口 IP 与节点落地 IP，均含位置和运营商。\n· 首行显示当前 Wi-Fi 名称，蜂窝网络下显示「蜂窝流量」。

[Panel]
网络IP信息 = title="网络IP信息",content="SSID: -\n\n本地 IP: -\n位置: -\n运营商: -\n\n────────────────\n◆策略: -\n入口: -\n位置: -\n运营商: -\n\n落地 IP: -\n位置: -\n运营商: -\n\n执行时间: -",style=info,script-name=网络IP信息,update-interval=600

[Script]
网络IP信息 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/ipinfo-panel.js,script-update-interval=86400,argument="{{{目标}}}",timeout=45
