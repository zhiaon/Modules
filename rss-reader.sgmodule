#!name=RSS订阅
#!desc=V1.0：订阅 RSS / Atom 源，面板列出最新条目；首次只建立基线，之后出现新内容才通知。
#!author=许舟
#!version=1.0
#!category=工具
#!arguments=订阅列表:-,通知:true,每个源条数:5,请求节点:-
#!arguments-desc=【订阅列表】\n是什么：要订阅的 RSS 或 Atom 源地址。\n怎么填：每个源一个地址，多个用英文分号分隔。\n· https://sspai.com/feed\n· 少数派=https://sspai.com/feed\n· https://github.com/用户名/仓库/releases.atom\n注意：最多 8 个源；带名字的写法只用于显示，随便起。\n\n【通知】\n是什么：出现新条目后是否发系统通知。\n怎么填：\n· true 有新条目时通知，点击可打开原文（默认）\n· false 只更新面板\n注意：首次运行只建立基线，不会把已有内容当成更新推送。\n\n【每个源条数】\n是什么：面板里每个源显示几条。\n怎么填：填 1 到 10 的数字。\n· 5 默认\n· 3 想短一点\n· 10 想看全一点\n注意：条目太多面板会很长，5 条一般够看。\n\n【请求节点】\n是什么：拉取订阅源使用的策略。\n怎么填：\n· - 跟随当前规则（默认）\n· Proxy 通过代理组\n· DIRECT 直连\n注意：境外源直连拉不到时，在这项指定走代理。\n\n————\n\n支持 RSS 2.0、RSS 1.0（RDF）、Atom 三种格式。\n面板每 30 分钟刷新，定时任务每 2 小时检查一次。\n新条目会在面板标 🆕 新并计数，首次只建立基线。

[Panel]
RSS订阅 = title="RSS订阅",content="正在读取订阅…\n\n如长时间无内容，请检查订阅地址\n例：https://sspai.com/feed",style=info,script-name=rss-reader-panel,update-interval=1800

[Script]
rss-reader-panel = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/rss-reader.js,script-update-interval=86400,argument="{{{订阅列表}}}|{{{通知}}}|{{{每个源条数}}}|{{{请求节点}}}",timeout=55,engine=webview
rss-reader-cron = type=cron,cronexp="0 */2 * * *",script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/rss-reader.js,script-update-interval=86400,argument="{{{订阅列表}}}|{{{通知}}}|{{{每个源条数}}}|{{{请求节点}}}",timeout=55,engine=webview,wake-system=true
