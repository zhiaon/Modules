#!name=Surge 内存监控
#!desc=V1.0 显示引擎真实物理内存、采样峰值/最低值、变化与活动连接数。自动刷新仅监控；20 秒内连续点两次刷新才重启引擎。重启会断开全部连接，清空缓存及临时规则。需 Surge iOS 6+ 且 http-api-mcp=true；无需控制密码或 MitM。
#!author=许舟
#!category=网络

[Panel]
Surge 内存监控 = title="Surge 内存监控",content="等待首次采样…\n自动刷新只监控。\n手动重启：20 秒内连续点两次右上角刷新。\n重启会断开全部连接并清空临时规则。",style=info,script-name=Surge 内存监控,update-interval=60

[Script]
Surge 内存监控 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/surge-memory-panel.js,script-update-interval=86400,timeout=15
