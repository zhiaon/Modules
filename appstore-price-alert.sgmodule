#!name=App Store降价提醒
#!desc=V1.0：监测指定应用在指定地区的 App Store 本体价格；首次静默建立基线，后续降价才通知。
#!author=许舟
#!version=1.0
#!category=工具
#!arguments=应用列表:-,默认地区:CN,通知:true,请求节点:-,降价阈值:0
#!arguments-desc=【应用列表】\n是什么：要监测价格的 App。\n怎么填：格式 名称=App Store ID@地区，多个用英文分号分隔。\n· ChatGPT=6448311069@US\n· ChatGPT=6448311069@US;Claude=6473753684@CN\n· 6448311069 只填 ID，使用默认地区\n注意：最多 12 个应用；地区不填时使用「默认地区」参数。\n\n【默认地区】\n是什么：应用没写地区时使用的 App Store 地区。\n怎么填：两位国家或地区代码。\n· CN 中国区（默认）\n· US 美区\n· TR 土耳其区\n· JP 日本区 / HK 香港区\n注意：不同地区价格与货币不同，需与账号所在区一致才有参考意义。\n\n【通知】\n是什么：发现降价后是否发系统通知。\n怎么填：\n· true 每日定时检查发现降价时通知（默认）\n· false 只更新面板\n注意：面板手动刷新不发送通知，只有定时任务会推。\n\n【请求节点】\n是什么：查询价格使用的策略。\n怎么填：\n· - 跟随当前规则（默认）\n· Proxy 通过代理组\n· DIRECT 直连\n注意：部分地区接口需要特定出口才能返回当地价格。\n\n【降价阈值】\n是什么：价格下降多少才提醒。\n怎么填：按该地区货币填数字。\n· 0 任意降价都提醒（默认）\n· 1 至少降 1 元\n· 10 至少降 10 元\n注意：阈值按该地区货币计算，不同地区不可直接横向比较。\n\n————\n\n只监测应用本体售价，不包含 App 内购或订阅套餐价格。\n首次运行只记录当前价格作为基线，不会把当前价格误报成降价。\n面板每 6 小时刷新，定时任务每天 09:00 检查一次。

[Panel]
App Store降价提醒 = title="App Store降价提醒",content="尚未配置应用\n\n打开模块 → 参数 → 应用列表\n格式：名称=App Store ID@地区\n首次只记录价格，后续降价才通知",style=info,script-name=appstore-price-panel,update-interval=21600

[Script]
appstore-price-panel = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/appstore-price-alert.js,script-update-interval=86400,argument="{{{应用列表}}}|{{{默认地区}}}|{{{通知}}}|{{{请求节点}}}|{{{降价阈值}}}",timeout=60,engine=webview
appstore-price-cron = type=cron,cronexp="0 9 * * *",script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/appstore-price-alert.js,script-update-interval=86400,argument="{{{应用列表}}}|{{{默认地区}}}|{{{通知}}}|{{{请求节点}}}|{{{降价阈值}}}",timeout=60,engine=webview,wake-system=true
