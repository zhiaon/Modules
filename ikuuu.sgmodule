#!name=iKuuu 每日签到
#!desc=iKuuu 每日签到：按设定时间签到，另有每 10 分钟本地补签检查；Cookie 失效时等待重新登录，当天成功后不重复提交，可选通知服务器回执与剩余流量。
#!author=Yjwj205 / 许舟（Surge 移植）
#!version=v1.3.1
#!category=工具
#!icon=calendar.badge.checkmark
#!homepage=https://github.com/Yjwj205/loon-modules
#!date=2026-11-15
#!arguments=cookie:-,capture:true,notify:true,cron:0 8 * * *,enabled:true,node:-,site:auto
#!arguments-desc=【cookie】\n功能说明：登录 ikuuu 后的会话凭据。\n配置方法：两种方式任选。\n取值示例：\n· - 留空，使用「抓取 Cookie」自动保存的那份\n· 直接粘贴 Cookie 整行，带 Cookie: 前缀也能识别\n注意事项：优先手填；确认手填值失效后，同站重新抓到的新会话可用于补签。\n\n【capture】\n功能说明：是否自动抓取登录 Cookie。\n配置方法：填写 true 或 false，默认 true。\n取值示例：\n· true 在 Safari 打开站点登录一次，自动保存 Cookie（默认）\n· false 不再写入新的 Cookie\n注意事项：关掉只是停止抓取，已保存的 Cookie 仍然可用；要自动接收重新登录后的 Cookie，请保持开启并打开用户中心。\n\n【notify】\n功能说明：签到完成后是否发系统通知。\n配置方法：填写 true 或 false，默认 true。\n取值示例：\n· true 弹通知，内容含服务器原文与剩余流量（默认）\n· false 静默执行\n注意事项：关闭只影响通知，签到照常进行。\n\n【cron】\n功能说明：每日首次签到时间。另有每10分钟本地补签检查，已签或等待登录时不请求签到接口。\n配置方法：五段 cron，依次是 分 时 日 月 周。\n取值示例：\n· 0 8 * * * 每天 08:00（默认）\n· 30 7 * * * 每天 07:30\n注意事项：使用本机时区，改完需重载模块生效。\n\n【enabled】\n功能说明：是否开启定时签到。\n配置方法：填写 true 或 false，默认 true。\n取值示例：\n· true 按 cron 自动签到（默认）\n· false 停止自动签到\n注意事项：本项目前只保留自动签到，没有内置面板。\n\n【node】\n功能说明：签到请求使用的策略。\n配置方法：填策略组名或节点名。\n取值示例：\n· - 留空，跟随当前规则（默认）\n· DIRECT 直连\n· Proxy 通过代理组\n注意事项：只有偶尔出现证书或 TLS 报错时才需要固定到某个节点。\n\n【site】\n功能说明：签到使用的站点域名。\n配置方法：从取值示例中选择一项填写。\n取值示例：\n· auto 自动使用抓 Cookie 时的域名，没抓过则用 ikuuu.org（默认）\n· ikuuu.org / ikuuu.pw / ikuuu.me 强制指定\n注意事项：站点更换域名后需同步修改，否则会签到失败。\n\n————\n\n整体备注：\n· 开关类参数只认 true 和 false 最稳妥；也兼容 0 / off / no / 关 / 关闭。\n· 写错成其他字样时按开启处理，建议统一用 true / false。\n· Cookie 与授权信息保存在模块持久化存储中，不写入脚本、不显示在面板。

[Script]
iKuuu Cookie 抓取 = type=http-request,pattern=^https:\/\/(?:[a-z0-9-]+\.)*ikuuu\.(?:org|pw|me)\/user(?:[/?]|$),script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/ikuuu-cookie.js,script-update-interval=86400,argument="{{{capture}}}|{{{notify}}}",timeout=10
iKuuu 定时签到 = type=cron,cronexp="{{{cron}}}",script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/ikuuu-checkin.js,script-update-interval=86400,argument="{{{cookie}}}|{{{notify}}}|{{{node}}}|{{{enabled}}}|{{{site}}}",timeout=60,wake-system=true
iKuuu 补签检查 = type=cron,cronexp="*/10 * * * *",script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/ikuuu-checkin.js,script-update-interval=86400,argument="{{{cookie}}}|{{{notify}}}|{{{node}}}|{{{enabled}}}|{{{site}}}|loop|{{{cron}}}",timeout=60,wake-system=true

[MITM]
hostname = %APPEND% ikuuu.org, *.ikuuu.org, ikuuu.pw, *.ikuuu.pw, ikuuu.me, *.ikuuu.me
