#!name=出门天气卡
#!desc=V1.1：详细出门天气卡。显示当前天气与体感、今日高低温、降水概率与雨量、湿度风力、紫外线、空气质量、日出日落、气压能见度阵风、未来 6 小时逐时预报，并给出雨伞/穿衣/运动/体感四项出门指数；每天 07:30 推送天气摘要。
#!author=许舟
#!version=1.1
#!category=工具
#!arguments=城市:-,通知:true,请求节点:-,降雨提醒阈值:50
#!arguments-desc=【城市】\n是什么：要查询天气的地点。\n怎么填：三种写法都行。\n· 城市名：杭州 / 上海 / 深圳\n· 经纬度：30.94,118.75\n· 自动：按出口 IP 定位\n注意：必填，不预填任何城市；留空时面板只显示待配置提示。\n\n【通知】\n是什么：每天早上是否推送当天天气摘要。\n怎么填：\n· true 每天 07:30 推送一次（默认）\n· false 只更新面板\n注意：同一天只推一次，不会重复打扰。\n\n【请求节点】\n是什么：查询天气与空气质量使用的策略。\n怎么填：\n· - 跟随当前规则（默认）\n· Proxy 通过代理组\n· DIRECT 直连\n注意：只有「自动」定位会受此影响，走代理会定位到代理所在地；DIRECT 下天气接口容易超时，建议直接填城市名或经纬度。\n\n【降雨提醒阈值】\n是什么：降水概率达到多少就建议带伞。\n怎么填：填 0 到 100 之间的数字。\n· 50 一半概率就提醒（默认）\n· 80 只有很大概率才提醒\n· 100 基本不提醒\n注意：该阈值同时影响出门指数里的雨伞建议。\n\n————\n\n数据来自 Open-Meteo，空气质量来自 Open-Meteo Air Quality，均无需 API Key。\n面板显示体感、高低温、降水与雨量、湿度风力、紫外线、空气质量、日出日落、气压能见度阵风、未来 6 小时逐时预报，以及雨伞/穿衣/运动/体感四项出门指数。\n面板每 30 分钟刷新；网络失败时显示上次同地点的成功数据。

[Panel]
出门天气卡 = title="出门天气卡",content="尚未填写城市\n\n打开模块 → 参数 → 城市\n可填城市名、经纬度或 自动\n例：杭州 / 30.94,118.75 / 自动",style=info,script-name=going-out-weather-panel,update-interval=1800

[Script]
going-out-weather-panel = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/going-out-weather.js,script-update-interval=86400,argument="{{{城市}}}|{{{通知}}}|{{{请求节点}}}|{{{降雨提醒阈值}}}",timeout=45,engine=webview
going-out-weather-cron = type=cron,cronexp="30 7 * * *",script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/going-out-weather.js,script-update-interval=86400,argument="{{{城市}}}|{{{通知}}}|{{{请求节点}}}|{{{降雨提醒阈值}}}",timeout=45,engine=webview,wake-system=true
