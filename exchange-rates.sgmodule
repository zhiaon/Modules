#!name=汇率显示面板
#!desc=V1.1：直接显示「1 单位外币等于多少基准货币」，如「1 USD（美元） = 6.6798 CNY」；小面值币种自动按 100 或 1000 单位显示，含数据更新时间。
#!author=许舟
#!version=1.1
#!category=工具
#!arguments=基准货币:CNY,目标货币:USD;EUR;GBP;JPY;HKD;TWD;KRW;SGD;THB;AUD;CAD;CHF;TRY;INR;MYR;IDR;PHP;NZD;AED;VND,请求节点:-
#!arguments-desc=【基准货币】\n是什么：汇率换算的起点，面板会显示 1 单位基准币能换多少目标币。\n怎么填：填写三位货币代码，默认 CNY。\n· CNY 人民币\n· USD 美元\n· EUR 欧元\n· HKD 港元\n· TWD 新台币\n\n注意：目标货币列表里会自动跳过与基准货币相同的代码。\n\n【目标货币】\n是什么：要对照显示的其他国家或地区货币。\n怎么填：填写三位代码，用英文分号分隔，最多 20 种。\n· 默认：USD;EUR;GBP;JPY;HKD;TWD;KRW;SGD;THB;AUD;CAD;CHF;TRY;INR;MYR;IDR;PHP;NZD;AED;VND\n· 只看几种：USD;JPY;HKD;TWD\n\n注意：代码使用 ISO 4217 标准；不认识或数据源不支持的币种会显示暂无数据。\n\n【请求节点】\n是什么：指定汇率接口使用的策略。\n怎么填：填策略组名或节点名；填 - 表示跟随当前规则。\n· Proxy：通过代理查询\n· DIRECT：直接连接\n\n————\n\n数据来源：ExchangeRate-API 免费接口，无需 API Key，基准数据每日更新。\n面板每 6 小时自动刷新，右上角刷新可立即查询。网络失败时显示上次成功缓存。\n汇率用于参考，实际兑换价格以银行或支付机构为准。

[Panel]
汇率显示面板 = title="汇率显示面板",content="正在获取汇率…\n\n基准：CNY\n目标：USD / EUR / GBP / JPY / HKD / TWD 等",style=info,script-name=exchange-rates-panel,update-interval=21600

[Script]
exchange-rates-panel = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/exchange-rates.js,script-update-interval=86400,argument="{{{基准货币}}}|{{{目标货币}}}|{{{请求节点}}}",timeout=30,engine=webview
