#!name=IP纯净度
#!desc=出口风险面板：显示 IP、位置、ASN、风险分与 VPN/代理/Tor/机房标签，可点击刷新，每 30 分钟自动刷新。风险分不是纯净度百分比，未匹配不代表安全。
#!author=许舟
#!version=v1.1.1
#!category=网络
#!icon=checkmark.shield
#!arguments=目标:AUTO
#!arguments-desc=【目标】\n功能说明：要检测出口风险的目标策略。\n配置方法：从取值示例中选择一项填写。\n取值示例：\n· AUTO 读取 FINAL 策略并发起查询（默认）\n· Proxy 指定策略组\n· DIRECT 检测直连出口\n· RULE 按当前规则访问接口\n注意事项：填写名称必须是当前配置里真实存在的策略。\n\n————\n\n整体备注：\n· 使用 IPQuery 免 Key 接口，显示 IP、位置、ASN、风险分与 VPN/代理/Tor/机房标签。\n· 点击刷新，自动刷新间隔 30 分钟。\n· 未匹配不等于安全，风险分也不是纯净度百分比，仅供参考。

[Panel]
IP纯净度 = title="IP 纯净度",content="点击检测当前出口 IP 风险",style=info,script-name=IP纯净度,update-interval=1800

[Script]
IP纯净度 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/ippurity-panel.js,script-update-interval=86400,argument="{{{目标}}}",timeout=22
