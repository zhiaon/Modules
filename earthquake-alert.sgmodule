#!name=地震速报（中国地震台网）
#!desc=中国地震台网公开目录速报，支持按手动位置和半径筛选，并为新事件发送带系统声音的通知。注意：这是震后速报，不是震前预警；Surge 脚本不能读取 iPhone GPS 或直接朗读文字。
#!author=Minis
#!version=1.2.1
#!category=工具
#!arguments=最低震级:4,通知:true,位置:-,半径:300,播报:true
#!arguments-desc=【最低震级】\n是什么：只显示并提醒达到该震级的记录。\n怎么填：0 到 10 之间的数字。\n· 4（默认）\n· 5 表示只看 M5.0 及以上\n注意：震级和地点以台网目录为准。\n\n【通知】\n是什么：是否发送符合范围的新地震通知。\n怎么填：true 开启，false 关闭。\n· true（默认）\n· false 只更新面板\n注意：首次运行或更换监测范围只建立基线，不追溯旧事件。\n\n【位置】\n是什么：附近地震筛选的中心点。\n怎么填：填中文城市或区县（如 杭州、浙江省杭州市），也可以填纬度,经度，例如 30.2741,120.1551；填 未设置 表示暂不发送附近提醒；填 - 表示全国中国境内目录；填 auto 可按出口 IP 粗略定位。\n· 30.2741,120.1551\n· -\n注意：默认 - 保持全国目录模式；auto 不是 GPS，使用代理时可能定位到代理出口。\n\n【半径】\n是什么：中心点周边的提醒范围，单位 km。\n怎么填：1 到 2000 的数字。\n· 300（默认）\n· 100\n注意：仅地名、坐标或 auto 模式生效；全国模式忽略。\n\n【播报】\n是什么：通知是否播放 iOS 系统提示音。\n怎么填：true 开启，false 关闭。\n· true（默认）\n· false 静音\n注意：这是通知音，不是语音朗读；Surge 脚本没有直接调用 iOS TTS 的接口。\n\n————\n\n数据源：中国地震台网公开地震目录。设备每 10 分钟轮询一次，使用 Last-Modified/ETag 条件请求。设置坐标后根据目录经纬度计算距离；全国模式按地点名称筛选中国境内记录。模块报告的是震后速报，不能提供震前预警，也不保证通知送达。Surge 需保持运行，iOS 可能延后或跳过定时任务。

[Panel]
地震速报 = title="地震速报",content="打开模块参数设置位置和筛选震级",style=info,script-name=地震速报(面板),update-interval=600

[Script]
地震速报(面板) = type=generic,engine=webview,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/earthquake-alert.js,script-update-interval=86400,argument="{{{最低震级}}}|{{{通知}}}|{{{位置}}}|{{{半径}}}|{{{播报}}}|panel",timeout=45
地震速报(定时) = type=cron,engine=webview,cronexp="*/10 * * * *",wake-system=true,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/earthquake-alert.js,script-update-interval=86400,argument="{{{最低震级}}}|{{{通知}}}|{{{位置}}}|{{{半径}}}|{{{播报}}}|cron",timeout=45
