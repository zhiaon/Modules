#!name=流媒体解锁
#!desc=V1.3 逐平台实测解锁状态：Netflix、Disney+、YouTube、Prime Video、Spotify、HBO Max、Hulu、Paramount+、Peacock、Viu、Abema、巴哈动画疯、B站港澳台，以及 ChatGPT / Claude / Gemini 三家人工智能服务。每个策略组一块，发真实请求看对方真正看到的地区，不靠 IP 库猜。V1.3 改为图标打头排版，任何机型、任何字号下勾叉列都不会再错位。
#!author=许舟
#!version=1.3
#!category=网络
#!icon=lock.open.fill
#!homepage=https://github.com/zhiaon/Modules
#!arguments=策略组:填写策略组名,平台:填写要测的平台
#!arguments-desc=【策略组】\n是什么：要测试解锁情况的策略组或节点。\n怎么填：填策略组名或节点名，多个用竖线分隔。\n· 美国|日本|中国台湾|中国香港\n· Proxy\n· 留空则只测 FINAL 那条兜底组\n注意：名称必须是当前配置里真实存在的策略，否则该行显示服务不可用。\n\n【平台】\n是什么：要测试哪些流媒体或 AI 平台。\n怎么填：填平台简写，多个用逗号分隔；留空则全测。\n· netflix / nf / 网飞 / 奈飞\n· disney / 迪士尼\n· youtube / yt / 油管\n· chatgpt / gpt / openai\n· ai 表示三个 AI 平台一起测\n注意：认识的简写不区分大小写，未识别的写法会被忽略。\n\n————\n\n共 16 个平台：Netflix、Disney+、YouTube、Prime Video、Spotify、HBO Max、Hulu、Paramount+、Peacock、Viu、Abema、巴哈动画疯、B站港澳台，以及 ChatGPT、Claude、Gemini。\n图标含义：✅ 已解锁 / 🟡 部分解锁或信号不明 / ❌ 未解锁 / ⚠️ 请求失败可重刷。\n测试会产生真实请求流量，按需执行。

[Panel]
流媒体解锁 = title="流媒体解锁",content="正在逐个平台实测…\n\n十六家平台各发一次真实请求，一般 3 秒出结果。\n点右上角的刷新按钮可以立即重测。",style=info,script-name=流媒体解锁,update-interval=1800

[Script]
流媒体解锁 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/streaming-panel.js,script-update-interval=86400,argument="{{{策略组}}}||{{{平台}}}",timeout=120
