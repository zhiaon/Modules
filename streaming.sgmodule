#!name=流媒体解锁
#!desc=流媒体解锁检测：对每个策略组发真实请求，逐平台显示 Netflix、Disney+、YouTube、Prime Video、Spotify、HBO Max、Hulu、Paramount+、Peacock、Viu、Abema、巴哈动画疯、B站港澳台与 ChatGPT、Claude、Gemini 的实际可见地区。
#!author=许舟
#!version=v1.3.1
#!category=网络
#!icon=lock.open.fill
#!homepage=https://github.com/zhiaon/Modules
#!arguments=策略组:填写策略组名,平台:填写要测的平台
#!arguments-desc=【策略组】\n功能说明：要测试解锁情况的策略组或节点。\n配置方法：填策略组名或节点名，多个用竖线分隔。\n取值示例：\n· 美国|日本|中国台湾|中国香港\n· Proxy\n· 留空则只测 FINAL 那条兜底组\n注意事项：名称必须是当前配置里真实存在的策略，否则该行显示服务不可用。\n\n【平台】\n功能说明：要测试哪些流媒体或 AI 平台。\n配置方法：填平台简写，多个用逗号分隔；留空则全测。\n取值示例：\n· netflix / nf / 网飞 / 奈飞\n· disney / 迪士尼\n· youtube / yt / 油管\n· chatgpt / gpt / openai\n· ai 表示三个 AI 平台一起测\n注意事项：认识的简写不区分大小写，未识别的写法会被忽略。\n\n————\n\n整体备注：\n· 共 16 个平台：Netflix、Disney+、YouTube、Prime Video、Spotify、HBO Max、Hulu、Paramount+、Peacock、Viu、Abema、巴哈动画疯、B站港澳台，以及 ChatGPT、Claude、Gemini。\n· 图标含义：✅ 已解锁 / 🟡 部分解锁或信号不明 / ❌ 未解锁 / ⚠️ 请求失败可重刷。\n· 测试会产生真实请求流量，按需执行。

[Panel]
流媒体解锁 = title="流媒体解锁",content="正在逐个平台实测…\n\n十六家平台各发一次真实请求，一般 3 秒出结果。\n点右上角的刷新按钮可以立即重测。",style=info,script-name=流媒体解锁,update-interval=1800

[Script]
流媒体解锁 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/streaming-panel.js,script-update-interval=86400,argument="{{{策略组}}}||{{{平台}}}",timeout=120
