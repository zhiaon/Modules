#!name=机场流量
#!desc=V1.0：复制订阅链接进去就可以了
#!author=zhiaon
#!category=网络
#!icon=gauge.with.needle
#!arguments=机场name1:填写机场名,订阅URL1:填写URL,重置日1:填写重置日,机场name2:填写机场名,订阅URL2:填写URL,重置日2:填写重置日,机场name3:填写机场名,订阅URL3:填写URL,重置日3:填写重置日,机场name4:填写机场名,订阅URL4:填写URL,重置日4:填写重置日,机场name5:填写机场名,订阅URL5:填写URL,重置日5:填写重置日,机场name6:填写机场名,订阅URL6:填写URL,重置日6:填写重置日
#!arguments-desc=【一句话】把机场的订阅链接复制进去就可以了，六个机场各一格，想用几个填几个。\n【① 机场name】这一格填机场名字，只用来显示，随便起，例：ikuuu、花云、云梯。名字里不要有英文逗号。\n【② 订阅URL】这一格填这家机场的订阅地址。从机场后台复制整条 https 链接，?token= 后面那一长串、& 后面的参数，全部照抄，别截断。\n【③ 重置日】这一格填这家机场每月几号流量清零，写数字 1 到 31。\n　　· 例：每月 6 号清零就填 6\n　　· 填 31 遇到小月（2 月、4 月等）自动按当月最后一天算，不会算错\n　　· 这格留空的话，自动沿用第一个填了重置日的机场；全都空就按 1 号\n【编号怎么对应】name1 + URL1 + 重置日1 是第 1 个机场，name2 + URL2 + 重置日2 是第 2 个，依此类推。三格必须填同一家，别串行。\n【不用的机场】保持默认的"填写机场名 / 填写URL / 填写重置日"不动就行，脚本认得这些占位词，会直接跳过那一组，不会报错。\n【为什么会显示占位文字】Surge 要求每个参数的默认值不能为空，所以默认值塞了提示文字。你把它覆盖掉就生效。\n【参数里不能有英文逗号】Surge 用逗号分隔参数，值里一旦出现英文逗号，整行会被截断，后半段直接丢失。链接里有逗号的话先别加这项。\n【面板看什么】总流量、已消耗、剩余、进度条、↑上行 ↓下行、下次重置日、到期日；多用几个机场会自动切成紧凑排版并在末尾给合计。\n【数据从哪来】直接读订阅响应头 subscription-userinfo，本机发起请求，链接和 token 只存在你本机，不经过任何第三方中转。

[Panel]
机场流量 = title="机场流量",content="数据加载中…\n\n点这张卡右上角的刷新按钮立即拉取，或等下次自动更新（10 分钟）",style=info,script-name=机场流量,update-interval=600

[Script]
机场流量 = type=generic,script-path=https://cdn.jsdelivr.net/gh/zhiaon/Modules@main/surge_scripts/airport-panel.js,argument="{{{机场name1}}}|{{{订阅URL1}}}|{{{重置日1}}}|{{{机场name2}}}|{{{订阅URL2}}}|{{{重置日2}}}|{{{机场name3}}}|{{{订阅URL3}}}|{{{重置日3}}}|{{{机场name4}}}|{{{订阅URL4}}}|{{{重置日4}}}|{{{机场name5}}}|{{{订阅URL5}}}|{{{重置日5}}}|{{{机场name6}}}|{{{订阅URL6}}}|{{{重置日6}}}",timeout=60
