#!name=机场流量
#!desc=V1.1：复制订阅链接进去就可以了。重置日留空则该机场不显示重置信息。
#!author=许舟
#!version=1.1
#!category=网络
#!icon=gauge.with.needle
#!arguments=机场name1:填写机场名,订阅URL1:填写URL,重置日1:填写重置日,机场name2:填写机场名,订阅URL2:填写URL,重置日2:填写重置日,机场name3:填写机场名,订阅URL3:填写URL,重置日3:填写重置日,机场name4:填写机场名,订阅URL4:填写URL,重置日4:填写重置日,机场name5:填写机场名,订阅URL5:填写URL,重置日5:填写重置日,机场name6:填写机场名,订阅URL6:填写URL,重置日6:填写重置日
#!arguments-desc=【机场name1】\n是什么：第一组机场的显示名称。\n怎么填：随意起名，仅用于显示。\n· ikuuu\n· 花云\n注意：名称里不要带英文逗号，否则参数会被截断。\n\n【订阅URL1】\n是什么：第一组机场的订阅地址。\n怎么填：从机场后台复制完整 https 链接。\n· https://example.com/api/v1/client/subscribe?token=xxx\n注意：?token= 后面的长串和 & 参数需完整照抄，截断会导致解析失败。\n\n【重置日1】\n是什么：第一组机场每月流量清零的日期。\n怎么填：填 1 到 31 的数字。\n· 6 每月 6 号清零\n· 31 遇小月自动按当月最后一天\n· 留空表示不显示重置信息\n注意：不限时流量包或一次性流量包留空即可。\n\n【机场name2】\n是什么：第二组机场的显示名称。\n怎么填：同第一组，不用就保持默认不动。\n· 云梯\n注意：编号必须与订阅URL2、重置日2 对应，不要串行。\n\n【订阅URL2】\n是什么：第二组机场的订阅地址。\n怎么填：同第一组，填完整订阅链接。\n· https://example2.com/api/v1/client/subscribe?token=yyy\n注意：必须与机场name2、重置日2 属于同一家机场。\n\n【重置日2】\n是什么：第二组机场每月流量清零的日期。\n怎么填：同第一组，填 1 到 31 或留空。\n· 1\n· 留空表示不显示\n注意：各家独立计算，留空那家不会跟着别的机场算。\n\n【机场name3】\n是什么：第三组机场的显示名称。\n怎么填：同前，不用就保持默认。\n· 备用机场\n注意：编号需与订阅URL3、重置日3 对应。\n\n【订阅URL3】\n是什么：第三组机场的订阅地址。\n怎么填：同前，填完整订阅链接。\n· https://example3.com/api/v1/client/subscribe?token=zzz\n注意：不用的组保持默认不动即可，不必清空。\n\n【重置日3】\n是什么：第三组机场每月流量清零的日期。\n怎么填：同前，填 1 到 31 或留空。\n· 15\n· 留空表示不显示\n注意：与订阅URL3 属于同一家机场。\n\n【机场name4】\n是什么：第四组机场的显示名称。\n怎么填：同前。\n· 备用线路\n注意：编号需与订阅URL4、重置日4 对应。\n\n【订阅URL4】\n是什么：第四组机场的订阅地址。\n怎么填：同前。\n· https://example4.com/api/v1/client/subscribe?token=aaa\n注意：不用的组保持默认不动。\n\n【重置日4】\n是什么：第四组机场每月流量清零的日期。\n怎么填：同前。\n· 20\n· 留空表示不显示\n注意：与订阅URL4 属于同一家机场。\n\n【机场name5】\n是什么：第五组机场的显示名称。\n怎么填：同前。\n· 临时机场\n注意：编号需与订阅URL5、重置日5 对应。\n\n【订阅URL5】\n是什么：第五组机场的订阅地址。\n怎么填：同前。\n· https://example5.com/api/v1/client/subscribe?token=bbb\n注意：不用的组保持默认不动。\n\n【重置日5】\n是什么：第五组机场每月流量清零的日期。\n怎么填：同前。\n· 25\n· 留空表示不显示\n注意：与订阅URL5 属于同一家机场。\n\n【机场name6】\n是什么：第六组机场的显示名称。\n怎么填：同前。\n· 备用账户\n注意：编号需与订阅URL6、重置日6 对应。\n\n【订阅URL6】\n是什么：第六组机场的订阅地址。\n怎么填：同前。\n· https://example6.com/api/v1/client/subscribe?token=ccc\n注意：不用的组保持默认不动。\n\n【重置日6】\n是什么：第六组机场每月流量清零的日期。\n怎么填：同前。\n· 1\n· 留空表示不显示\n注意：与订阅URL6 属于同一家机场。\n\n————\n\n六个机场各一格，想用几个填几个，不用的那组保持默认不动。\n同一编号的 name / URL / 重置日 必须属于同一家机场，三格串行会导致显示错乱。\n订阅链接含账号凭据，面板不显示具体内容，只在解析成功时给出流量信息。

[Panel]
机场流量 = title="机场流量",content="数据加载中…\n\n点这张卡右上角的刷新按钮立即拉取，或等下次自动更新（10 分钟）",style=info,script-name=机场流量,update-interval=600

[Script]
机场流量 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/airport-panel.js,argument="{{{机场name1}}}|{{{订阅URL1}}}|{{{重置日1}}}|{{{机场name2}}}|{{{订阅URL2}}}|{{{重置日2}}}|{{{机场name3}}}|{{{订阅URL3}}}|{{{重置日3}}}|{{{机场name4}}}|{{{订阅URL4}}}|{{{重置日4}}}|{{{机场name5}}}|{{{订阅URL5}}}|{{{重置日5}}}|{{{机场name6}}}|{{{订阅URL6}}}|{{{重置日6}}}",timeout=60
