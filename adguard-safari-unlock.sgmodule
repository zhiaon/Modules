#!name=AdGuard Safari 扩展解锁
#!desc=修改 AdGuard Safari 扩展收据校验响应，将产品状态设为 ACTIVE 以解锁高级功能
#!version=v1.0.0
#!category=解锁
#!author=chxm1023 (Minis 转换)
#!homepage=https://github.com/chxm1023/Rewrite

[Script]
AdGuard解锁 = type=http-response,pattern=^https:\/\/mobile-api\.adguard\.org\/api\/.+\/ios_validate_receipt\/,requires-body=1,max-size=1048576,timeout=30,script-update-interval=86400,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/adguard-safari.js

[MITM]
hostname = %APPEND% mobile-api.adguard.org
