#!name=双出口 IP 面板
#!author=许舟
#!version=1.1
#!desc=V1.1 详细双出口面板：IP、IPv4/IPv6、国家/省市、运营商/组织、ASN、时区、查询来源、每路耗时与更新时间；点右上角刷新立即查询。
#!category=网络
#!system=ios
#!arguments=policy:Proxy
#!arguments-desc=【policy】\n是什么：要查询出口 IP 的策略组或节点。\n怎么填：填策略组名或节点名。\n· AUTO 自动读取 FINAL 策略（默认）\n· Proxy 指定策略组\n· DIRECT 查询直连出口\n注意：填写的名称必须是当前配置里真实存在的策略，否则查询失败。\n\n————\n\n面板显示 IP、IPv4/IPv6、国家省市、运营商/组织、ASN、时区、查询来源与每路耗时。\n点右上角刷新立即重新查询。

[Panel]
双出口 IP 面板 = title="双出口 IP · 详细",content="DIRECT 与代理出口等待查询…\n点右上角刷新按钮查询",style=info,script-name=双出口 IP 查询,update-interval=600

[Script]
双出口 IP 查询 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/dual-ip-panel.js,script-update-interval=86400,argument="{{{policy}}}",timeout=15,engine=jsc
