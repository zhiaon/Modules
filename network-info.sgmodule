#!name=网络信息 𝕏
#!category=工具
#!version=v1.0.0
#!desc=查询并展示当前网络信息：直连与落地 IP、运营商与位置、代理策略、SSID 与局域网地址；支持通知推送与 Surge 面板定时刷新显示。
#!author=6otho / xream (Minis 转换)
#!homepage=https://github.com/6otho/Loon_tool
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/Fancynetwork(1).png

[Rule]
DOMAIN-SUFFIX,speedtest.cn,DIRECT
DOMAIN-SUFFIX,ip.im,DIRECT
DOMAIN-SUFFIX,ip.plus,DIRECT

[Script]
network-panel = type=generic,script-update-interval=86400,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/network.js,timeout=120,argument="LAN=0&SSID=0&IPv6=0&MASK=0&DOMESTIC_IPv4=spcn&DOMESTIC_IPv6=ddnspod&LANDING_IPv4=ipapi&LANDING_IPv6=ipsb&PRIVACY=0&FLAG=1&ENTRANCE_DELAY=0"
网络信息请求 𝕏 = type=http-request,pattern=^https?:\/\/net-lsp-x\.com,script-update-interval=86400,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/network.js,timeout=120

[Panel]
网络信息 𝕏 = script-name=network-panel,update-interval=300

[MITM]
hostname = %APPEND% net-lsp-x.com
