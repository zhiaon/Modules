#!name=多平台签到
#!desc=多平台签到中心：统一调度贴吧与 B 站签到，支持 Cookie 自动捕获、各平台独立开关与时间、失败重试与只读面板；账号数据仅保存在本机，签到结果以接口回执为准。
#!version=v1.0.1
#!arguments=auto:true,time:08:00,capture:true,notify:true,retries:1,request_timeout:8,task_timeout:30,tieba_enabled:true,tieba_auto:true,tieba_time:follow,bilibili_enabled:true,bilibili_auto:true,bilibili_time:follow,smzdm_enabled:true,smzdm_auto:true,smzdm_time:follow
#!arguments-desc=【auto】\n功能说明：统一自动签到开关，默认 true。\n配置方法：填写小写布尔值。\n取值示例：\n· true：开启\n· false：关闭\n注意事项：关闭只停自动签到，手动仍可运行；各平台还须开启 enabled 和 auto。\n\n【time】\n功能说明：统一签到时间，默认 08:00，使用手机本地时区。\n配置方法：填写 24 小时制 HH:MM。\n取值示例：\n· 08:00：每天早上八点\n· 21:30：每天晚上九点半\n注意事项：平台独立时间优先；不要填 Cron 表达式。当天到点后可补跑，不保证准点。\n\n【capture】\n功能说明：本模块的 Cookie 自动捕获开关，默认 true。\n配置方法：填写小写布尔值。\n取值示例：\n· true：开启捕获\n· false：停止捕获\n注意事项：关闭不会清除已有 Cookie，也不阻止使用已有 Cookie 签到；HTTPS 捕获需要 MITM 生效。\n\n【notify】\n功能说明：本模块的执行报告与 Cookie 捕获通知开关，默认 true。\n配置方法：填写小写布尔值。\n取值示例：\n· true：允许通知\n· false：不发通知\n注意事项：关闭仍保留本地执行记录；开启不代表 iOS 通知权限已经允许。\n\n【retries】\n功能说明：安全只读请求失败后的重试次数，默认 1。\n配置方法：填写 0–2 的整数，不含首次请求。\n取值示例：\n· 0：不重试\n· 1：最多重试一次\n· 2：最多重试两次\n注意事项：只重试网络、超时或 5xx 的安全读取；签到提交与 403、429 不自动重试。\n\n【request_timeout】\n功能说明：单次 HTTP 请求超时秒数，默认 8。\n配置方法：填写 3–15 的整数。\n取值示例：\n· 8：八秒\n· 15：十五秒\n注意事项：剩余任务预算不足时会缩短；提交超时不代表服务器未处理，不能据此盲目重签。\n\n【task_timeout】\n功能说明：单个平台的执行预算秒数，默认 30。\n配置方法：填写 10–32 的整数。\n取值示例：\n· 10：十秒\n· 30：三十秒\n注意事项：平台多吧签到可能因预算不足停止；整个批次另有约 103 秒预算，不会无限等待。\n\n【tieba_enabled】\n功能说明：贴吧平台总开关，默认 true。\n配置方法：填写小写布尔值。\n取值示例：\n· true：启用\n· false：停用\n注意事项：停用同时阻止自动和手动签到，但不清除 Cookie；启用后仍须通过管理命令设置明确吧名清单。\n\n【tieba_auto】\n功能说明：贴吧独立自动签到开关，默认 true。\n配置方法：填写小写布尔值。\n取值示例：\n· true：允许自动签到\n· false：只保留手动签到\n注意事项：自动执行还需要 auto 和 tieba_enabled 为 true；关闭本项不影响其他平台。\n\n【tieba_time】\n功能说明：贴吧独立签到时间，默认 follow。\n配置方法：填写 follow 或 24 小时制 HH:MM。\n取值示例：\n· follow：跟随 time\n· 07:30：每天七点半\n注意事项：独立时间覆盖统一时间，但不会绕过自动开关；不能把部分关注列表当作全部贴吧。\n\n【bilibili_enabled】\n功能说明：B 站平台总开关，默认 true。\n配置方法：填写小写布尔值。\n取值示例：\n· true：启用\n· false：停用\n注意事项：停用同时阻止自动和手动签到；本版仅直播每日签到，不执行观看、投币或分享，尚待真实账号验证。\n\n【bilibili_auto】\n功能说明：B 站独立自动签到开关，默认 true。\n配置方法：填写小写布尔值。\n取值示例：\n· true：允许自动签到\n· false：只保留手动签到\n注意事项：自动执行还需要 auto 和 bilibili_enabled 为 true；关闭本项不影响其他平台。\n\n【bilibili_time】\n功能说明：B 站独立签到时间，默认 follow。\n配置方法：填写 follow 或 24 小时制 HH:MM。\n取值示例：\n· follow：跟随 time\n· 09:00：每天九点\n注意事项：独立时间覆盖统一时间；设置时间不会新建 Cron，也不会开启已关闭的自动签到。\n\n【smzdm_enabled】\n功能说明：什么值得买平台总开关，默认 true，当前为预留项。\n配置方法：填写小写布尔值。\n取值示例：\n· true：保留平台入口\n· false：停用平台\n注意事项：当前适配器返回 unsupported，不发签到请求；开启此项不能使未支持的功能变为可用。\n\n【smzdm_auto】\n功能说明：什么值得买独立自动调度开关，默认 true。\n配置方法：填写小写布尔值。\n取值示例：\n· true：允许参与调度\n· false：不参与自动调度\n注意事项：当前只能记录暂不支持，不会签到；关闭本项不影响其他平台，也不删除历史。\n\n【smzdm_time】\n功能说明：什么值得买独立调度时间，默认 follow。\n配置方法：填写 follow 或 24 小时制 HH:MM。\n取值示例：\n· follow：跟随 time\n· 08:30：每天八点半\n注意事项：当前平台暂不支持签到，设置独立时间不会改变此限制。\n\n————\n\n整体备注：\n· 固定 Cron 每分钟检查本地设置，wake-system=false；Surge 未运行、iOS 挂起或系统限制都可能延迟执行，不保证锁屏准点。每个平台每天默认只预约一次自动尝试，失败或缺 Cookie 后也不会当天反复自动提交；需要时可手动运行，仍受同分钟防重和限流退避约束。\n· Cookie 仅保存在本地，不保证加密；捕获不等于登录有效。贴吧仅明确清单，B 站仅直播签到，均尚待真实账号验证；什么值得买暂不支持。三个原生面板均只读，刷新不会签到。通知不包含 Cookie；未测项目不标为成功。

[Script]
CC自动调度 = type=cron,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/multi-platform-checkin.js,script-update-interval=86400,engine=jsc,timeout=120,cronexp="* * * * *",wake-system=false,argument="action=schedule&auto={{{auto}}}&time={{{time}}}&capture={{{capture}}}&notify={{{notify}}}&retries={{{retries}}}&request_timeout={{{request_timeout}}}&task_timeout={{{task_timeout}}}&tieba_enabled={{{tieba_enabled}}}&tieba_auto={{{tieba_auto}}}&tieba_time={{{tieba_time}}}&bilibili_enabled={{{bilibili_enabled}}}&bilibili_auto={{{bilibili_auto}}}&bilibili_time={{{bilibili_time}}}&smzdm_enabled={{{smzdm_enabled}}}&smzdm_auto={{{smzdm_auto}}}&smzdm_time={{{smzdm_time}}}"
CC一键签到 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/multi-platform-checkin.js,script-update-interval=86400,engine=jsc,timeout=120,argument="action=run&platform=all&auto={{{auto}}}&time={{{time}}}&capture={{{capture}}}&notify={{{notify}}}&retries={{{retries}}}&request_timeout={{{request_timeout}}}&task_timeout={{{task_timeout}}}&tieba_enabled={{{tieba_enabled}}}&tieba_auto={{{tieba_auto}}}&tieba_time={{{tieba_time}}}&bilibili_enabled={{{bilibili_enabled}}}&bilibili_auto={{{bilibili_auto}}}&bilibili_time={{{bilibili_time}}}&smzdm_enabled={{{smzdm_enabled}}}&smzdm_auto={{{smzdm_auto}}}&smzdm_time={{{smzdm_time}}}"
CC贴吧签到 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/multi-platform-checkin.js,script-update-interval=86400,engine=jsc,timeout=120,argument="action=run&platform=tieba&auto={{{auto}}}&time={{{time}}}&capture={{{capture}}}&notify={{{notify}}}&retries={{{retries}}}&request_timeout={{{request_timeout}}}&task_timeout={{{task_timeout}}}&tieba_enabled={{{tieba_enabled}}}&tieba_auto={{{tieba_auto}}}&tieba_time={{{tieba_time}}}&bilibili_enabled={{{bilibili_enabled}}}&bilibili_auto={{{bilibili_auto}}}&bilibili_time={{{bilibili_time}}}&smzdm_enabled={{{smzdm_enabled}}}&smzdm_auto={{{smzdm_auto}}}&smzdm_time={{{smzdm_time}}}"
CCB站签到 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/multi-platform-checkin.js,script-update-interval=86400,engine=jsc,timeout=120,argument="action=run&platform=bilibili&auto={{{auto}}}&time={{{time}}}&capture={{{capture}}}&notify={{{notify}}}&retries={{{retries}}}&request_timeout={{{request_timeout}}}&task_timeout={{{task_timeout}}}&tieba_enabled={{{tieba_enabled}}}&tieba_auto={{{tieba_auto}}}&tieba_time={{{tieba_time}}}&bilibili_enabled={{{bilibili_enabled}}}&bilibili_auto={{{bilibili_auto}}}&bilibili_time={{{bilibili_time}}}&smzdm_enabled={{{smzdm_enabled}}}&smzdm_auto={{{smzdm_auto}}}&smzdm_time={{{smzdm_time}}}"
CC值得买签到 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/multi-platform-checkin.js,script-update-interval=86400,engine=jsc,timeout=120,argument="action=run&platform=smzdm&auto={{{auto}}}&time={{{time}}}&capture={{{capture}}}&notify={{{notify}}}&retries={{{retries}}}&request_timeout={{{request_timeout}}}&task_timeout={{{task_timeout}}}&tieba_enabled={{{tieba_enabled}}}&tieba_auto={{{tieba_auto}}}&tieba_time={{{tieba_time}}}&bilibili_enabled={{{bilibili_enabled}}}&bilibili_auto={{{bilibili_auto}}}&bilibili_time={{{bilibili_time}}}&smzdm_enabled={{{smzdm_enabled}}}&smzdm_auto={{{smzdm_auto}}}&smzdm_time={{{smzdm_time}}}"
CC管理命令 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/multi-platform-checkin.js,script-update-interval=86400,engine=jsc,timeout=120,argument="action=command&auto={{{auto}}}&time={{{time}}}&capture={{{capture}}}&notify={{{notify}}}&retries={{{retries}}}&request_timeout={{{request_timeout}}}&task_timeout={{{task_timeout}}}&tieba_enabled={{{tieba_enabled}}}&tieba_auto={{{tieba_auto}}}&tieba_time={{{tieba_time}}}&bilibili_enabled={{{bilibili_enabled}}}&bilibili_auto={{{bilibili_auto}}}&bilibili_time={{{bilibili_time}}}&smzdm_enabled={{{smzdm_enabled}}}&smzdm_auto={{{smzdm_auto}}}&smzdm_time={{{smzdm_time}}}"
CC总览面板 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/multi-platform-checkin.js,script-update-interval=86400,engine=jsc,timeout=5,argument="action=panel&view=overview&auto={{{auto}}}&time={{{time}}}&capture={{{capture}}}&notify={{{notify}}}&retries={{{retries}}}&request_timeout={{{request_timeout}}}&task_timeout={{{task_timeout}}}&tieba_enabled={{{tieba_enabled}}}&tieba_auto={{{tieba_auto}}}&tieba_time={{{tieba_time}}}&bilibili_enabled={{{bilibili_enabled}}}&bilibili_auto={{{bilibili_auto}}}&bilibili_time={{{bilibili_time}}}&smzdm_enabled={{{smzdm_enabled}}}&smzdm_auto={{{smzdm_auto}}}&smzdm_time={{{smzdm_time}}}"
CC平台面板 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/multi-platform-checkin.js,script-update-interval=86400,engine=jsc,timeout=5,argument="action=panel&view=platforms&auto={{{auto}}}&time={{{time}}}&capture={{{capture}}}&notify={{{notify}}}&retries={{{retries}}}&request_timeout={{{request_timeout}}}&task_timeout={{{task_timeout}}}&tieba_enabled={{{tieba_enabled}}}&tieba_auto={{{tieba_auto}}}&tieba_time={{{tieba_time}}}&bilibili_enabled={{{bilibili_enabled}}}&bilibili_auto={{{bilibili_auto}}}&bilibili_time={{{bilibili_time}}}&smzdm_enabled={{{smzdm_enabled}}}&smzdm_auto={{{smzdm_auto}}}&smzdm_time={{{smzdm_time}}}"
CC统计面板 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/multi-platform-checkin.js,script-update-interval=86400,engine=jsc,timeout=5,argument="action=panel&view=statistics&auto={{{auto}}}&time={{{time}}}&capture={{{capture}}}&notify={{{notify}}}&retries={{{retries}}}&request_timeout={{{request_timeout}}}&task_timeout={{{task_timeout}}}&tieba_enabled={{{tieba_enabled}}}&tieba_auto={{{tieba_auto}}}&tieba_time={{{tieba_time}}}&bilibili_enabled={{{bilibili_enabled}}}&bilibili_auto={{{bilibili_auto}}}&bilibili_time={{{bilibili_time}}}&smzdm_enabled={{{smzdm_enabled}}}&smzdm_auto={{{smzdm_auto}}}&smzdm_time={{{smzdm_time}}}"
CC捕获贴吧 = type=http-request,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/multi-platform-checkin.js,script-update-interval=86400,engine=jsc,timeout=5,pattern=^https:\/\/tieba\.baidu\.com\/(?:dc\/common\/tbs|mo\/q\/newmoindex|f(?:\?|\/|$)),argument="action=capture&auto={{{auto}}}&time={{{time}}}&capture={{{capture}}}&notify={{{notify}}}&retries={{{retries}}}&request_timeout={{{request_timeout}}}&task_timeout={{{task_timeout}}}&tieba_enabled={{{tieba_enabled}}}&tieba_auto={{{tieba_auto}}}&tieba_time={{{tieba_time}}}&bilibili_enabled={{{bilibili_enabled}}}&bilibili_auto={{{bilibili_auto}}}&bilibili_time={{{bilibili_time}}}&smzdm_enabled={{{smzdm_enabled}}}&smzdm_auto={{{smzdm_auto}}}&smzdm_time={{{smzdm_time}}}"
CC捕获B站 = type=http-request,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/multi-platform-checkin.js,script-update-interval=86400,engine=jsc,timeout=5,pattern=^https:\/\/(?:(?:www|live)\.bilibili\.com\/(?:\?|$)|api\.bilibili\.com\/x\/web-interface\/nav|api\.live\.bilibili\.com\/xlive\/web-ucenter\/v1\/sign\/),argument="action=capture&auto={{{auto}}}&time={{{time}}}&capture={{{capture}}}&notify={{{notify}}}&retries={{{retries}}}&request_timeout={{{request_timeout}}}&task_timeout={{{task_timeout}}}&tieba_enabled={{{tieba_enabled}}}&tieba_auto={{{tieba_auto}}}&tieba_time={{{tieba_time}}}&bilibili_enabled={{{bilibili_enabled}}}&bilibili_auto={{{bilibili_auto}}}&bilibili_time={{{bilibili_time}}}&smzdm_enabled={{{smzdm_enabled}}}&smzdm_auto={{{smzdm_auto}}}&smzdm_time={{{smzdm_time}}}"
CC捕获值得买 = type=http-request,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/multi-platform-checkin.js,script-update-interval=86400,engine=jsc,timeout=5,pattern=^https:\/\/zhiyou\.smzdm\.com\/(?:\?|$|user(?:\/|$)),argument="action=capture&auto={{{auto}}}&time={{{time}}}&capture={{{capture}}}&notify={{{notify}}}&retries={{{retries}}}&request_timeout={{{request_timeout}}}&task_timeout={{{task_timeout}}}&tieba_enabled={{{tieba_enabled}}}&tieba_auto={{{tieba_auto}}}&tieba_time={{{tieba_time}}}&bilibili_enabled={{{bilibili_enabled}}}&bilibili_auto={{{bilibili_auto}}}&bilibili_time={{{bilibili_time}}}&smzdm_enabled={{{smzdm_enabled}}}&smzdm_auto={{{smzdm_auto}}}&smzdm_time={{{smzdm_time}}}"

[Panel]
CC总览 = title=CHECKIN CENTER,content=等待首次刷新,script-name=CC总览面板,update-interval=60
CC平台 = title=平台管理,content=等待首次刷新,script-name=CC平台面板,update-interval=60
CC统计 = title=签到统计,content=等待首次刷新,script-name=CC统计面板,update-interval=60

[MITM]
hostname = %APPEND% tieba.baidu.com, www.bilibili.com, api.bilibili.com, live.bilibili.com, api.live.bilibili.com, zhiyou.smzdm.com
