#!name=服务器流量
#!desc=直连 AWS Lightsail API，按自定义域名监控 VPS 出站/入站流量、配额、计费周期、到期时间，并自动检测域名解析是否仍指向实例 IP。全程本机 SigV4 签名，不经过任何中转服务器。
#!author=zhiaon
#!category=网络
#!icon=server.rack
#!arguments=ak:填入AWS_Access_Key_ID,sk:填入AWS_Secret_Access_Key,region:ap-southeast-1,quota:2048,instances:Debian-1;Debian-2,hosts:Debian-1:ls1.zhiaon.top;Debian-2:ls2.zhiaon.top,labels:Debian-1:ls1;Debian-2:ls2,billdays:Debian-1:17;Debian-2:1,expiry:Debian-1:2026-12-31;Debian-2:2027-01-15
#!arguments-desc=⓵ ak / sk【必填】：IAM 访问密钥，权限只需 lightsail:GetInstances 与 lightsail:GetInstanceMetricData。把「填入AWS_Access_Key_ID」整段替换成你自己的 key。\n⓶ region：实例所在区域，默认 ap-southeast-1。\n⓷ quota：每台实例每月出站配额(GB)，Lightsail 2048GB 套餐填 2048。\n⓸ instances：要监控的实例名，多台用分号分隔，例如 Debian-1;Debian-2。留空则显示账号下全部实例。\n⓹ hosts：实例与域名对应，用于显示域名并检测 IP 漂移。格式 实例名:域名，多组用分号分隔。\n⓺ labels：面板显示名。格式 实例名:显示名，多组用分号分隔。不填则用域名或实例名。\n⓻ billdays：计费日(1-28)。Lightsail 按实例创建日滚动，不是自然月。格式 实例名:日期。不填按每月 1 号。\n⓼ expiry：到期日。格式 实例名:YYYY-MM-DD。不填则不显示到期信息。\n⓽ 重要：多组配置统一用分号 ; 分隔各组、冒号 : 分隔键值，绝对不要用英文逗号——Surge 会在逗号处截断整个参数。

[Panel]
服务器流量 = script-name=服务器流量,update-interval=1800

[Script]
服务器流量 = type=generic,timeout=25,script-path=https://raw.githubusercontent.com/zhiaon/Module/main/surge_scripts/vps-panel.js,script-update-interval=0
流量预警 = type=cron,cronexp=0 10,20 * * *,wake-system=1,timeout=40,script-path=https://raw.githubusercontent.com/zhiaon/Module/main/surge_scripts/vps-alert.js,script-update-interval=0
