#!name=WorkBuddy签到与积分
#!desc=V1.3 多手机号积分面板与每日签到。依赖自建 WorkBuddy 反代受限接口；手机号用逗号分隔，逐号显示余额。无网页登录与 MITM。
#!author=许舟
#!category=工具
#!icon=calendar.badge.checkmark
#!date=2026-11-15
#!arguments=phone:-,key:-,server:-,cron:0 9 * * *,enabled:true,notify:true
#!arguments-desc=phone：多个手机号用逗号分隔，最多20个；留-查询后台全部活跃账号。\nserver：自建受限接口基础地址，包含/api/surge；必须HTTPS。\nkey：该接口专用密钥，不是管理员密码。\n仅填写手机号不能直接登录新账号，需先在反代后台登录。\ncron：本机时区的五段cron，默认每天09:00。\nenabled：定时签到开关，false不影响手动签到。\nnotify：签到通知开关。\n余额是服务器快照；签到作用于后台全部活跃账号。参数只保存在你自己的Surge配置中。

[Panel]
WorkBuddy签到与积分 = title="WorkBuddy 积分",content="请先填写模块参数",style=info,script-name=WorkBuddy积分面板,update-interval=900

[Script]
WorkBuddy积分面板 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/workbuddy-checkin.js,script-update-interval=86400,argument="{{{enabled}}}|{{{notify}}}|{{{phone}}}|{{{key}}}|{{{server}}}|{{{cron}}}",timeout=60,engine=webview
WorkBuddy每日签到 = type=cron,cronexp="{{{cron}}}",script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/workbuddy-checkin.js,script-update-interval=86400,argument="{{{enabled}}}|{{{notify}}}|{{{phone}}}|{{{key}}}|{{{server}}}|{{{cron}}}",timeout=60,engine=webview,wake-system=true
