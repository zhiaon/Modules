#!name=追更提醒
#!desc=追更提醒：从 360 影视、优酷、腾讯视频搜索中文剧，Bangumi 与 TVmaze 补充信息，仅匹配精确的正片更新标记，首次静默、跨源去重后通知。
#!version=v1.4.1
#!author=许舟
#!category=工具
#!arguments=剧单:-
#!arguments-desc=【剧单】\n功能说明：要追看的剧名；直接填剧名即可追踪。\n配置方法：多部用分号分隔，最多 5 部。\n取值示例：\n· 十万狂花入梦来\n· 庆余年 第二季;Breaking Bad\n· 庆余年 第二季 第12集（手动设已看进度）\n· Breaking Bad S02E03（按季进度）\n· bgm:353464（明确指定旧条目）\n注意事项：同名版本请加年份；无法确认时会显示候选，不会自行猜测。\n\n————\n\n整体备注：\n· 中文剧依次查询360影视、优酷、腾讯视频公开搜索；海外剧保留TVmaze，动画保留Bangumi。平台总集数不作为已更新集数；只采纳精确正片的明确更新或完结标签，标记不明的数据源会跳过。平台进度可能含会员档位，不代表免费可看或平台间同步。\n· 只填剧名：首次静默记录当前已播集，后续新集才通知。每30分钟检查、跨源逐集去重；原剧单及定时设置保留。仅有播出日期时按北京时间当日结束。iOS调度可能延迟，请允许Surge通知。

[Panel]
追更提醒 = title=追更提醒,content=只填剧名即可自动追更；首次静默，之后新集通知,script-name=episode-watch-panel,update-interval=1800

[Script]
episode-watch-panel = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/episode-watch.js,script-update-interval=86400,argument="panel|{{{剧单}}}",timeout=75,engine=jsc
episode-watch-cron = type=cron,cronexp="*/30 * * * *",script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/episode-watch.js,script-update-interval=86400,argument="cron|{{{剧单}}}",timeout=75,engine=jsc,wake-system=true
