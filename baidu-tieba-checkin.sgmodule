#!name=百度贴吧签到
#!desc=百度贴吧每日签到：自动捕获登录 Cookie，按设定时间调度签到，账号信息仅保存在本机。
#!version=v1.0.0
#!openUrl=https://tieba.baidu.com
#!author=Minis
#!homepage=https://manual.nssurge.com/scripting/overview.html
#!icon=https://tieba.baidu.com/favicon.ico
#!arguments=auto_sign:true,auto_capture:true,sign_time:0 8 * * *
#!arguments-desc=【auto_sign】\n功能说明：控制百度贴吧是否按每日设定时间自动签到。\n配置方法：开启 true，关闭 false。\n取值示例：\n· true（默认开启）\n· false（关闭自动签到，仍可手动签到）\n注意事项：关闭时每日Cron只触发一次本地开关检查，不请求贴吧；其他时间不运行签到任务。\n\n【auto_capture】\n功能说明：控制是否捕获贴吧请求中的登录Cookie或登录响应下发的Cookie。\n配置方法：开启 true，关闭 false。\n取值示例：\n· true（默认，仅匹配 tieba.baidu.com、passport.baidu.com）\n· false（不捕获，已有本地会话仍保留）\n注意事项：只接受 BDUSS、BDUSS_BFESS；HTTPS抓取需要贴吧和百度登录主机的MITM。每次成功捕获到完整会话（包括重复值）均通知；auto_capture=false时不捕获也不通知。\n\n【sign_time】\n功能说明：每日签到唯一的Cron执行时间。\n配置方法：填五字段Cron“分 时 * * *”，仅支持每天一个明确分钟和小时。\n取值示例：\n· 0 8 * * *（每天08:00，默认）\n· 30 7 * * *（每天07:30）\n注意事项：不要填非单一每日时间、范围或列表；只有此时触发签到检查，已签到不通知，新签到成功才通知。\n\n————\n\n整体备注：\n· 数据来源：%APPEND%、tieba.baidu.com、passport.baidu.com\n· 刷新机制：面板每 86400 秒自动刷新；定时任务 {{{sign_time}}} 触发\n· 执行方式：Surge 定时任务与脚本按需触发\n· 隐私安全：参数与缓存仅保存在本机，网络请求只发往上述数据来源。

[Script]
TB自动签到 = type=cron,cronexp="{{{sign_time}}}",wake-system=true,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/tieba-daily.js,script-update-interval=86400,timeout=120,argument="auto|{{{auto_sign}}}|{{{auto_capture}}}|{{{sign_time}}}"
TB立即签到 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/tieba-daily.js,script-update-interval=86400,timeout=120,argument="manual|{{{auto_sign}}}|{{{auto_capture}}}|{{{sign_time}}}"
TB绑定贴吧会话 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/tieba-daily.js,script-update-interval=86400,timeout=10,argument="bind|{{{auto_sign}}}|{{{auto_capture}}}|{{{sign_time}}}"
TB清除贴吧会话 = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/tieba-daily.js,script-update-interval=86400,timeout=10,argument="forget|{{{auto_sign}}}|{{{auto_capture}}}|{{{sign_time}}}"
TB捕获贴吧Cookie = type=http-request,pattern=^https:\/\/(?:tieba|passport)\.baidu\.com(?:\/|\?|$),script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/tieba-daily.js,script-update-interval=86400,timeout=5,argument="capture|{{{auto_sign}}}|{{{auto_capture}}}|{{{sign_time}}}"
TB响应抓取贴吧Cookie = type=http-response,pattern=^https:\/\/(?:tieba|passport)\.baidu\.com(?:\/|\?|$),script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/tieba-daily.js,script-update-interval=86400,full-header-mode=true,requires-body=false,timeout=5,argument="capture|{{{auto_sign}}}|{{{auto_capture}}}|{{{sign_time}}}"

[MITM]
hostname = %APPEND% tieba.baidu.com, passport.baidu.com
