#!name=今日入账
#!desc=V1.3：采用分组留白排版；详细显示今日收入、预计总额、计薪工时、工作进度、两段用餐休息与下班倒计时，以及本月累计与含本班合计。纯本地计算，每60秒刷新。
#!author=许舟
#!version=1.3
#!category=工具
#!arguments=上班时间:-,午饭加休息开始:-,午饭加休息结束:-,晚饭加休息开始:-,晚饭加休息结束:-,下班时间:-,本月休息日:-,自定义记录:-,每小时工资:-
#!arguments-desc=【上班时间】\n是什么：每天开始计薪的时间点。\n怎么填：24 小时制，格式 时:分。\n· 09:00\n· 08:30\n注意：与下班时间配合判断是否跨夜，必填。\n\n【午饭加休息开始】\n是什么：午饭休息的起始时间。\n怎么填：24 小时制，格式 时:分。\n· 12:00\n· - 留空表示没有这段休息\n注意：必须与「午饭加休息结束」成对填写，只填一项不生效。\n\n【午饭加休息结束】\n是什么：午饭休息的结束时间。\n怎么填：24 小时制，格式 时:分。\n· 13:00\n· - 留空表示没有这段休息\n注意：必须与「午饭加休息开始」成对填写，休息期间暂停计薪。\n\n【晚饭加休息开始】\n是什么：晚饭休息的起始时间。\n怎么填：24 小时制，格式 时:分。\n· 18:00\n· - 留空表示没有晚饭休息，直接工作到下班\n注意：必须与「晚饭加休息结束」成对填写。\n\n【晚饭加休息结束】\n是什么：晚饭休息的结束时间。\n怎么填：24 小时制，格式 时:分。\n· 18:30\n· - 留空表示没有这段休息\n注意：两段休息与班内时间重叠时只扣一次，不重复计算。\n\n【下班时间】\n是什么：每天结束计薪的时间点。\n怎么填：24 小时制，格式 时:分。\n· 18:00\n· 22:00\n注意：早于上班时间时按跨夜处理，必填。\n\n【本月休息日】\n是什么：本月不上班、不计薪的日期号。\n怎么填：填日期数字，多个用分号分隔。\n· 6;7;13;14\n· - 留空表示本月没有休息日\n注意：每月需手动更新；不会自动排除周末。\n\n【自定义记录】\n是什么：直接指定某天的工时和金额，覆盖实时估算。\n怎么填：格式 日期号:小时:金额，多条用分号分隔。\n· 5:8:160\n· 5:8:160;8:4:80\n注意：优先级高于「本月休息日」和实时估算，用于补录或修正。\n\n【每小时工资】\n是什么：计算收入的时薪。\n怎么填：填数字，单位元。\n· 20\n· 35.5\n注意：与上班时间、下班时间同为必填；三项未填齐时只显示待配置。\n\n————\n\n所有参数默认都不预填实际值，- 只表示未填写，不是数值 0。\n本月累计不含当前工作日，另外单独显示包含本班的合计。\n面板每 60 秒刷新，纯本地计算，不联网。

[Panel]
今日入账 = script-name=salary-widget-remote,update-interval=60

[Script]
salary-widget-remote = type=generic,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/salary-widget-panel.js,script-update-interval=86400,timeout=10,argument="WORK_START={{{上班时间}}}|LUNCH_START={{{午饭加休息开始}}}|LUNCH_END={{{午饭加休息结束}}}|DINNER_START={{{晚饭加休息开始}}}|DINNER_END={{{晚饭加休息结束}}}|WORK_END={{{下班时间}}}|REST_DAYS={{{本月休息日}}}|CUSTOM_DAYS={{{自定义记录}}}|HOURLY_WAGE={{{每小时工资}}}"
